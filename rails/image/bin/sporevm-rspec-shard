#!/usr/local/bin/ruby
# frozen_string_literal: true

# Load Rails and the spec suite once, serve a warm request, then wait to be
# saved and forked. Each forked child resumes inside this process, serves a
# request, and runs its share of the examples without loading anything again.

require "json"

IDENTITY_ENV = "/run/sporevm/env"

$stdout.sync = true
$stderr.sync = true

def monotonic_ms
  Process.clock_gettime(Process::CLOCK_MONOTONIC, :float_millisecond)
end

def health_request
  started = monotonic_ms
  response = Rack::MockRequest.new(Rails.application).get("/health")
  abort "GET /health returned #{response.status}: #{response.body}" unless response.status == 200

  [JSON.parse(response.body).fetch("widget_count"), (monotonic_ms - started).round(1)]
end

# Returns [index, count] once SporeVM has published this child's fork identity.
def fork_identity
  env = File.readlines(IDENTITY_ENV, chomp: true).filter_map { |line| line.split("=", 2) if line.include?("=") }.to_h
  return nil unless env["SPORE_FORK_BATCH_ID"] && env["SPORE_GENERATION"].to_i > env["SPORE_PARENT_GENERATION"].to_i

  [Integer(env.fetch("SPORE_PARALLEL_JOB"), 10), Integer(env.fetch("SPORE_PARALLEL_JOB_COUNT"), 10)]
rescue Errno::ENOENT, KeyError
  nil
end

started = monotonic_ms
$LOAD_PATH.unshift(File.expand_path("spec"))
require "rails_helper"
RSpec.configuration.files_or_directories_to_run = ["spec"]
RSpec.configuration.load_spec_files
examples = RSpec.world.all_examples.map(&:id).sort
abort "could not load the spec suite" if RSpec.world.wants_to_quit || examples.empty?

_, warm_ms = health_request
puts "SPOREVM_RAILS_READY examples=#{examples.size} boot_ms=#{(monotonic_ms - started).round} warm_request_ms=#{warm_ms}"

# The host saves the VM here. Without --continue-after-save the parent stops,
# so only forked children get past this loop.
sleep 0.01 until (identity = fork_identity)
index, count = identity
abort "invalid fork identity #{index}/#{count}" unless count.positive? && index >= 0 && index < count

widget_count, response_ms = health_request
puts "SPOREVM_RAILS_RESPONSE parallel_index=#{index} parallel_count=#{count} status=200 widget_count=#{widget_count} duration_ms=#{response_ms}"

selected = examples.select.with_index { |_, i| i % count == index }
RSpec.world.all_examples.each { |example| example.metadata[:sporevm_shard] = selected.include?(example.id) }
RSpec.configuration.filter_run_including(sporevm_shard: true)
status = RSpec::Core::Runner.run([], $stderr, $stdout)
# Report the examples RSpec actually ran so the host catches missed or repeated ones.
puts "SPOREVM_RSPEC_DONE parallel_index=#{index} parallel_count=#{count} examples=#{RSpec.configuration.reporter.examples.size} exit=#{status}"
exit status
