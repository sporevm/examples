#!/usr/local/bin/ruby
# frozen_string_literal: true

require "json"
require "open3"
require "rbconfig"
require "tempfile"

IDENTITY_ENV = "/run/sporevm/env"
IDENTITY_JSON = "/run/sporevm/generation.json"
CHILD_CONTEXT = "/tmp/sporevm-rails/child-context.json"
CHILD_CONTEXT_SCHEMA = "sporevm-rails-child-context.v2"
CHILD_CONTEXT_ENV = %w[
  HOME
  LANG
  PATH
  GEM_HOME
  BUNDLE_GEMFILE
  BUNDLE_PATH
  BUNDLE_WITHOUT
  RAILS_ENV
  RACK_ENV
  SPOREVM_POSTGRES_BIN
  SPOREVM_RAILS_RUNTIME_ROOT
].freeze
CHILD_CONTEXT_FIXED_ENV = {
  "HOME" => "/tmp/sporevm-home",
  "LANG" => "C.UTF-8",
  "PATH" => "/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
  "GEM_HOME" => File.join("/usr/local/bundle/ruby", RbConfig::CONFIG.fetch("ruby_version")),
  "BUNDLE_GEMFILE" => "/tmp/sporevm-rails/app/Gemfile",
  "BUNDLE_PATH" => "/usr/local/bundle",
  "BUNDLE_WITHOUT" => "development",
  "RAILS_ENV" => "test",
  "RACK_ENV" => "test",
  "SPOREVM_RAILS_RUNTIME_ROOT" => "/tmp/sporevm-rails"
}.freeze
CHILD_CONTEXT_CWD = "/tmp/sporevm-rails/app"
CHILD_CONTEXT_REEXEC_ARG = "--sporevm-child-context-loaded"
CHILD_RUBY = "/usr/local/bin/ruby"
POSTGRES_DATA = "/tmp/sporevm-postgres/data"
POSTGRES_SOCKET_DIR = "/tmp/sporevm-postgres/run"
POSTGRES_LOG_DIR = "/tmp/sporevm-postgres/log"
POSTGRES_DATABASE = "sporevm_rails_test"
POSTGRES_PORT = "5432"
POSTGRES_START_TIMEOUT = 15
SU_EXEC = "/sbin/su-exec"

def child_context_payload(cwd: Dir.pwd, env: ENV)
  {
    "schema" => CHILD_CONTEXT_SCHEMA,
    "environment" => CHILD_CONTEXT_ENV.to_h { |key| [key, env.fetch(key)] },
    "cwd" => cwd
  }
end

def validate_child_context(context, expected_cwd: CHILD_CONTEXT_CWD)
  expected_keys = %w[cwd environment schema]
  abort "invalid Rails child context fields" unless context.is_a?(Hash) && context.keys.sort == expected_keys
  abort "invalid Rails child context schema" unless context["schema"] == CHILD_CONTEXT_SCHEMA
  abort "invalid Rails child context cwd" unless context["cwd"] == expected_cwd

  environment = context["environment"]
  unless environment.is_a?(Hash) && environment.keys.sort == CHILD_CONTEXT_ENV.sort && environment.values.all? { |value| value.is_a?(String) }
    abort "invalid Rails child context environment"
  end
  CHILD_CONTEXT_FIXED_ENV.each do |key, value|
    abort "invalid Rails child context #{key}" unless environment[key] == value
  end
  postgres_bin = environment.fetch("SPOREVM_POSTGRES_BIN")
  unless postgres_bin.match?(%r{\A/[A-Za-z0-9_+./-]+\z}) && File.expand_path(postgres_bin) == postgres_bin && postgres_bin.bytesize <= 255
    abort "invalid Rails child context PostgreSQL path"
  end

  environment
rescue KeyError
  abort "invalid Rails child context environment"
end

def persist_child_context(path, expected_cwd: CHILD_CONTEXT_CWD)
  context = child_context_payload
  validate_child_context(context, expected_cwd: expected_cwd)
  temporary = "#{path}.tmp-#{Process.pid}"
  File.open(temporary, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    file.write(JSON.generate(context))
    file.write("\n")
    file.flush
    file.fsync
  end
  File.rename(temporary, path)
rescue KeyError, SystemCallError => e
  abort "could not persist Rails child context: #{e.message}"
ensure
  File.unlink(temporary) if temporary && File.exist?(temporary)
end

def load_child_context(path, expected_cwd: CHILD_CONTEXT_CWD)
  context = JSON.parse(File.read(path))
  environment = validate_child_context(context, expected_cwd: expected_cwd)
  environment.each { |key, value| ENV[key] = value }
  Dir.chdir(context["cwd"])
rescue JSON::ParserError, SystemCallError
  abort "could not load Rails child context"
end

def monotonic_ms
  (Process.clock_gettime(Process::CLOCK_MONOTONIC) * 1000).round
end

def postgres_tool(name)
  abort "invalid PostgreSQL tool" unless %w[pg_controldata pg_ctl pg_isready postgres psql].include?(name)

  path = File.join(ENV.fetch("SPOREVM_POSTGRES_BIN"), name)
  abort "PostgreSQL tool is unavailable: #{name}" unless File.file?(path) && File.executable?(path)

  path
end

def postgres_command(*command)
  abort "su-exec is unavailable" unless File.file?(SU_EXEC) && File.executable?(SU_EXEC)

  [SU_EXEC, "postgres", *command]
end

def command_output(command, environment = {})
  Open3.capture3(environment, *command)
rescue SystemCallError => error
  ["", error.message, nil]
end

def wait_for_process(pid, deadline)
  loop do
    result = Process.wait2(pid, Process::WNOHANG)
    return result.last if result
    return nil if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.02
  end
end

def terminate_process_group(pid)
  Process.kill("TERM", -pid)
  status = wait_for_process(pid, Process.clock_gettime(Process::CLOCK_MONOTONIC) + 0.5)
  return status if status

  Process.kill("KILL", -pid)
  Process.wait2(pid).last
rescue Errno::ESRCH
  Process.wait2(pid).last
rescue Errno::ECHILD
  nil
end

def bounded_command_output(command, environment = {}, timeout_seconds:)
  pid = nil
  status = nil
  timed_out = false
  output = nil
  Tempfile.create("sporevm-postgres-stdout") do |stdout|
    Tempfile.create("sporevm-postgres-stderr") do |stderr|
      pid = Process.spawn(environment, *command, out: stdout, err: stderr, pgroup: true)
      deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout_seconds
      status = wait_for_process(pid, deadline)
      unless status
        timed_out = true
        status = terminate_process_group(pid)
      end
      stdout.rewind
      stderr.rewind
      error_output = stderr.read(4096)
      error_output = "#{error_output}\ncommand timed out" if timed_out
      output = [stdout.read(4096), error_output, status]
    end
  end
  output
rescue SystemCallError => error
  ["", error.message, nil]
ensure
  terminate_process_group(pid) if pid && !status
end

def command_detail(*chunks)
  detail = chunks.join(" ").encode("UTF-8", invalid: :replace, undef: :replace, replace: "?")
  detail = detail.gsub(/\s+/, " ").strip
  detail.empty? ? "unavailable" : detail.byteslice([detail.bytesize - 512, 0].max, 512)
end

def postgres_process_pids(proc_root: "/proc")
  abort "cannot inspect PostgreSQL processes" unless Dir.exist?(proc_root)

  target = File.realpath(postgres_tool("postgres"))
  Dir.children(proc_root).filter_map do |entry|
    next unless entry.match?(/\A\d+\z/)

    process_name = File.read(File.join(proc_root, entry, "comm")).strip
    next unless %w[postgres postmaster].include?(process_name)

    executable = File.realpath(File.join(proc_root, entry, "exe"))
    Integer(entry, 10) if executable == target
  rescue Errno::EACCES
    abort "cannot inspect PostgreSQL processes"
  rescue Errno::ENOENT
    nil
  end
end

def stop_postgres_seed
  started = monotonic_ms
  command = postgres_command(
    postgres_tool("pg_ctl"), "-D", POSTGRES_DATA,
    "-m", "fast", "-w", "-t", POSTGRES_START_TIMEOUT.to_s, "stop"
  )
  stdout, stderr, status = command_output(command)
  unless status&.success?
    puts "SPOREVM_POSTGRES_SEED state=failed reason=shutdown"
    warn "PostgreSQL seed shutdown failed: #{command_detail(stdout, stderr)}"
    abort "could not stop PostgreSQL before capture"
  end
  abort "could not sync PostgreSQL seed" unless system("/bin/sync", out: File::NULL, err: File::NULL)

  control_stdout, control_stderr, control_status = command_output(
    postgres_command(postgres_tool("pg_controldata"), POSTGRES_DATA)
  )
  unless control_status&.success? && control_stdout.match?(/^Database cluster state:\s+shut down\s*$/)
    puts "SPOREVM_POSTGRES_SEED state=failed reason=control"
    warn "PostgreSQL seed state invalid: #{command_detail(control_stdout, control_stderr)}"
    abort "PostgreSQL seed is not cleanly shut down"
  end

  residual_paths = [
    File.join(POSTGRES_DATA, "postmaster.pid"),
    File.join(POSTGRES_SOCKET_DIR, ".s.PGSQL.5432"),
    File.join(POSTGRES_SOCKET_DIR, ".s.PGSQL.5432.lock")
  ].select { |path| File.exist?(path) }
  abort "PostgreSQL seed retained runtime files" unless residual_paths.empty?
  abort "PostgreSQL seed retained live processes" unless postgres_process_pids.empty?

  puts "SPOREVM_POSTGRES_SEED state=stopped duration_ms=#{monotonic_ms - started}"
end

def postgres_ready?
  _, _, ready_status = bounded_command_output(
    [
      postgres_tool("pg_isready"), "-q", "-h", POSTGRES_SOCKET_DIR,
      "-p", POSTGRES_PORT, "-d", POSTGRES_DATABASE, "-U", "postgres", "-t", "1"
    ],
    timeout_seconds: 3
  )
  return false unless ready_status&.success?

  stdout, _, identity_status = bounded_command_output(
    [
      postgres_tool("psql"), "-XAtqw", "-h", POSTGRES_SOCKET_DIR,
      "-p", POSTGRES_PORT, "-d", POSTGRES_DATABASE, "-U", "postgres", "-v", "ON_ERROR_STOP=1",
      "-c", "SELECT current_database(), current_setting('data_directory')"
    ],
    {"PGCONNECT_TIMEOUT" => "2", "PGOPTIONS" => "-c statement_timeout=2000"},
    timeout_seconds: 3
  )
  identity_status&.success? && stdout.strip == "#{POSTGRES_DATABASE}|#{POSTGRES_DATA}"
end

def resume_postgres(proc_root: "/proc")
  started = monotonic_ms
  live_pids = postgres_process_pids(proc_root: proc_root)
  unless live_pids.empty?
    puts "SPOREVM_POSTGRES_RESUME action=refused status=failed reason=live_unavailable"
    abort "a PostgreSQL process is live but unavailable"
  end

  stdout, stderr, status = command_output(postgres_command(
    postgres_tool("pg_ctl"), "-D", POSTGRES_DATA,
    "-l", File.join(POSTGRES_LOG_DIR, "postgres-resume.log"),
    "-w", "-t", POSTGRES_START_TIMEOUT.to_s, "start"
  ))
  unless status&.success?
    puts "SPOREVM_POSTGRES_RESUME action=started status=failed reason=startup"
    warn "PostgreSQL resume failed: #{command_detail(stdout, stderr)}"
    abort "could not resume PostgreSQL"
  end
  unless postgres_ready?
    puts "SPOREVM_POSTGRES_RESUME action=started status=failed reason=identity"
    abort "resumed PostgreSQL identity is invalid"
  end

  puts "SPOREVM_POSTGRES_RESUME action=started status=ready duration_ms=#{monotonic_ms - started}"
end

def parse_args(argv)
  capture_delay = nil
  child_context_loaded = false

  until argv.empty?
    arg = argv.shift
    case arg
    when "--capture-delay"
      raw = argv.shift
      abort "missing --capture-delay value" unless raw

      capture_delay = Integer(raw, 10)
      abort "--capture-delay must be greater than zero" unless capture_delay.positive?
    when CHILD_CONTEXT_REEXEC_ARG
      abort "duplicate #{CHILD_CONTEXT_REEXEC_ARG}" if child_context_loaded

      child_context_loaded = true
    when "-h", "--help"
      puts "usage: sporevm-rspec-shard [--capture-delay SECONDS]"
      exit 0
    else
      abort "unknown argument: #{arg}"
    end
  end

  abort "invalid Rails child context invocation" if capture_delay && child_context_loaded
  [capture_delay, child_context_loaded]
rescue ArgumentError
  abort "--capture-delay must be a positive integer"
end

def parse_positive_timeout(raw)
  timeout = Float(raw || "5")
  timeout.positive? ? timeout : 5.0
rescue ArgumentError
  5.0
end

def parse_env_identity(path)
  return nil unless File.file?(path)

  values = {}
  File.foreach(path) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    values[key] = value if key && value
  end

  job = values["SPORE_PARALLEL_JOB"]
  count = values["SPORE_PARALLEL_JOB_COUNT"]
  return nil unless job && count

  {
    "parallel_index" => Integer(job, 10),
    "parallel_count" => Integer(count, 10),
    "fork_batch_id" => values["SPORE_FORK_BATCH_ID"],
    "vm_id" => values["SPORE_VM_ID"],
    "source" => path
  }
rescue ArgumentError => e
  warn "could not parse #{path}: #{e.message}"
  nil
end

def parse_json_identity(path)
  return nil unless File.file?(path)

  params = JSON.parse(File.read(path))
  index = params["parallel_index"] || params["fork_index"]
  count = params["parallel_count"] || params["fork_count"]
  return nil unless index && count

  params.merge(
    "parallel_index" => Integer(index),
    "parallel_count" => Integer(count),
    "source" => path
  )
rescue JSON::ParserError, ArgumentError => e
  warn "could not parse #{path}: #{e.message}"
  nil
end

def read_identity
  timeout = parse_positive_timeout(ENV["SPOREVM_RSPEC_IDENTITY_TIMEOUT"])
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout

  loop do
    identity = parse_env_identity(IDENTITY_ENV) || parse_json_identity(IDENTITY_JSON)
    return identity if identity

    break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

    sleep 0.1
  end

  if ENV["SPOREVM_RSPEC_ALLOW_UNSHARDED"] == "1"
    return {
      "parallel_index" => 0,
      "parallel_count" => 1,
      "source" => "unsharded-fallback"
    }
  end

  abort "missing SporeVM fanout identity in #{IDENTITY_ENV} or #{IDENTITY_JSON}"
end

def preload_for_capture(capture_delay)
  start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  require "./config/environment"
  Rails.application.eager_load!
  require "rspec/rails"
  preload_seconds = Process.clock_gettime(Process::CLOCK_MONOTONIC) - start

  puts "rails preload ok"
  puts "SPOREVM_RAILS_PRELOAD_TIMING preload=#{format('%.3f', preload_seconds)}s"
  stop_postgres_seed
  puts "SPOREVM_RAILS_READY pid=#{Process.pid} capture_delay=#{capture_delay}"
  STDOUT.flush

  # `run --from` resumes this session beside the fresh shard command. Keep the
  # coordinator parked so its shell EXIT trap cannot stop that shard's server.
  loop { sleep 3600 }
end

def run_specs(selected)
  require "rspec/core" unless defined?(RSpec::Core::Runner)

  RSpec::Core::Runner.run(selected, $stderr, $stdout)
end

def main
  capture_delay, child_context_loaded = parse_args(ARGV)
  if capture_delay
    ENV["PATH"] = CHILD_CONTEXT_FIXED_ENV.fetch("PATH")
    persist_child_context(CHILD_CONTEXT)
  elsif File.file?(CHILD_CONTEXT)
    load_child_context(CHILD_CONTEXT)
    unless child_context_loaded
      exec(CHILD_RUBY, File.realpath(__FILE__), CHILD_CONTEXT_REEXEC_ARG)
    end
    require "bundler/setup"
  elsif child_context_loaded || File.file?(IDENTITY_ENV) || File.file?(IDENTITY_JSON)
    abort "missing captured Rails child context in #{CHILD_CONTEXT}"
  end
  preload_for_capture(capture_delay) if capture_delay

  identity = read_identity
  parallel_index = identity.fetch("parallel_index")
  parallel_count = identity.fetch("parallel_count")

  if parallel_count < 1
    abort "invalid SPORE_PARALLEL_JOB_COUNT=#{parallel_count}"
  end
  if parallel_index.negative? || parallel_index >= parallel_count
    abort "invalid SPORE_PARALLEL_JOB=#{parallel_index} for count #{parallel_count}"
  end
  resume_postgres if child_context_loaded

  specs = Dir["spec/**/*_spec.rb"].sort
  selected = specs.each_with_index.select { |_path, i| (i % parallel_count) == parallel_index }.map(&:first)

  puts "SPOREVM_RSPEC_SHARD parallel_index=#{parallel_index} parallel_count=#{parallel_count} selected=#{selected.length} identity_source=#{identity.fetch("source")}"
  if selected.empty?
    puts "SPOREVM_RSPEC_DONE parallel_index=#{parallel_index} parallel_count=#{parallel_count} exit=0"
    exit 0
  end

  status = run_specs(selected)
  puts "SPOREVM_RSPEC_DONE parallel_index=#{parallel_index} parallel_count=#{parallel_count} exit=#{status}"
  exit status
end

main if __FILE__ == $PROGRAM_NAME
