#!/bin/bash
set -euo pipefail

# Start PostgreSQL in guest RAM, load the schema, then hand over to the Ruby
# process that loads Rails and waits to be saved and forked. PostgreSQL keeps
# running across the save, so every child resumes with its own live server.

export HOME=/tmp/sporevm-home
export LANG=C.UTF-8
export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export RAILS_ENV=test
export RACK_ENV=test
export SPOREVM_RAILS_RUNTIME_ROOT=/tmp/sporevm-rails
export BUNDLE_GEMFILE=/tmp/sporevm-rails/app/Gemfile
export BUNDLE_PATH=/usr/local/bundle

pg_data=/tmp/sporevm-postgres/data
pg_run=/tmp/sporevm-postgres/run
pg_log=/tmp/sporevm-postgres/log

mkdir -p "${HOME}" "${SPOREVM_RAILS_RUNTIME_ROOT}" "${pg_data}" "${pg_run}" "${pg_log}"
cp -a /opt/sporevm-rails-src "${SPOREVM_RAILS_RUNTIME_ROOT}/app"
chown -R postgres:postgres /tmp/sporevm-postgres

su-exec postgres initdb -D "${pg_data}" --auth=trust --no-locale >"${pg_log}/initdb.log"
cat >>"${pg_data}/postgresql.conf" <<EOF
listen_addresses = ''
unix_socket_directories = '${pg_run}'
fsync = off
full_page_writes = off
synchronous_commit = off
EOF
su-exec postgres pg_ctl -D "${pg_data}" -l "${pg_log}/postgres.log" -w start
su-exec postgres createdb -h "${pg_run}" sporevm_rails_test

cd "${SPOREVM_RAILS_RUNTIME_ROOT}/app"
bundle exec ruby bin/rails db:schema:load >"${SPOREVM_RAILS_RUNTIME_ROOT}/schema-load.log"
exec bundle exec ruby /usr/local/bin/sporevm-rspec-shard
