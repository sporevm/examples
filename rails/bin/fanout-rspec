#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage:
  rails/bin/fanout-rspec [options]

Build the Rails/PostgreSQL image with `spore build`, boot it once, load Rails
and the spec suite, serve one warm request, and save the running VM. Then fork
child spores from that save and resume them with `spore checkpoint fanout`: each child
serves a request and runs its share of the RSpec examples in the already-warm
Ruby process. Exits non-zero if any child fails.

Options:
  --count N           Number of children (default: 4)
  --image REF         Image to run (default: local/sporevm-rails-rspec:dev);
                      only local/ refs are built, others are pulled
  --no-image-build    Run a local --image as is instead of building it first
  --memory SIZE       Guest RAM (default: 2gb)
  --timeout SECONDS   Stop the children after this long (default: 300)
  --workdir DIR       Directory for the save, children, and logs (default: mktemp)
  --spore-bin PATH    spore CLI to use (default: $SPORE_BIN or spore on PATH)
  -h, --help          Show this help
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

need_value() {
  [[ -n "${2-}" ]] || die "$1 requires a value"
}

valid_positive_int() {
  [[ "$1" =~ ^[1-9][0-9]*$ ]]
}

phase() {
  printf '\n==> %s\n' "$*"
}

# Wall-clock milliseconds; whole seconds on bash < 5.
now_ms() {
  if [[ -n "${EPOCHREALTIME:-}" ]]; then
    echo "$(( ${EPOCHREALTIME/[.,]/} / 1000 ))"
  else
    echo "$(( $(date +%s) * 1000 ))"
  fi
}

example_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
image_ref="local/sporevm-rails-rspec:dev"
count=4
memory=2gb
timeout=300
workdir=""
spore_bin="${SPORE_BIN:-spore}"
image_build=1

while (($#)); do
  case "$1" in
    --count|--image|--memory|--timeout|--workdir|--spore-bin)
      need_value "$1" "${2-}"
      case "$1" in
        --count) count="$2" ;;
        --image) image_ref="$2" ;;
        --memory) memory="$2" ;;
        --timeout) timeout="$2" ;;
        --workdir) workdir="$2" ;;
        --spore-bin) spore_bin="$2" ;;
      esac
      shift 2
      ;;
    --no-image-build)
      image_build=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

valid_positive_int "${count}" || die "--count must be a positive integer"
valid_positive_int "${timeout}" || die "--timeout must be a positive integer"
command -v "${spore_bin}" >/dev/null 2>&1 || die "spore not found: ${spore_bin}; set SPORE_BIN or pass --spore-bin"
# spore build only publishes local/ refs; spore run pulls registry images.
[[ "${image_ref}" == local/* ]] || image_build=0

if [[ -z "${workdir}" ]]; then
  workdir="$(mktemp -d "${TMPDIR:-/tmp}/sporevm-rails-rspec.XXXXXX")"
fi
save_dir="${workdir}/rails.spore"
children_dir="${workdir}/children"
rm -rf -- "${save_dir}" "${children_dir}"
mkdir -p "${workdir}"

run_pid=""
cleanup() {
  if [[ -n "${run_pid}" ]]; then
    kill -TERM "${run_pid}" >/dev/null 2>&1 || true
    wait "${run_pid}" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

printf 'spore:    %s (%s)\n' "$(command -v "${spore_bin}")" "$("${spore_bin}" version 2>/dev/null || echo unknown)"
printf 'image:    %s\n' "${image_ref}"
printf 'children: %s\n' "${count}"
printf 'workdir:  %s\n' "${workdir}"

build_ms=0
if [[ "${image_build}" == "1" ]]; then
  phase "build ${image_ref}"
  started="$(now_ms)"
  "${spore_bin}" build --tag "${image_ref}" --memory 4gb --vcpus 4 "${example_dir}"
  build_ms="$(( $(now_ms) - started ))"
fi

phase "boot Rails once, then save"
started="$(now_ms)"
"${spore_bin}" run --image "${image_ref}" --memory "${memory}" --save-checkpoint "${save_dir}" --save-on USR1 \
  -- /bin/bash /usr/local/bin/sporevm-rails-coordinator >"${workdir}/parent.log" 2>&1 &
run_pid="$!"

for ((polls = timeout * 10; polls > 0; polls--)); do
  grep -q '^SPOREVM_RAILS_READY ' "${workdir}/parent.log" && break
  kill -0 "${run_pid}" 2>/dev/null || break
  sleep 0.1
done
if ! grep -q '^SPOREVM_RAILS_READY ' "${workdir}/parent.log"; then
  cat "${workdir}/parent.log" >&2
  die "Rails did not become ready in the parent VM"
fi
ready_ms="$(( $(now_ms) - started ))"
grep '^SPOREVM_RAILS_READY ' "${workdir}/parent.log"
total_examples="$(sed -n 's/^SPOREVM_RAILS_READY examples=\([0-9]*\) .*/\1/p' "${workdir}/parent.log")"

started="$(now_ms)"
kill -USR1 "${run_pid}"
while kill -0 "${run_pid}" 2>/dev/null; do
  if (( $(now_ms) - started > 60000 )); then
    cat "${workdir}/parent.log" >&2
    die "spore run did not finish saving within 60s"
  fi
  sleep 0.01
done
if ! wait "${run_pid}"; then
  run_pid=""
  cat "${workdir}/parent.log" >&2
  die "spore run did not save cleanly"
fi
run_pid=""
save_ms="$(( $(now_ms) - started ))"

phase "fork ${count} children"
started="$(now_ms)"
"${spore_bin}" checkpoint fork "${save_dir}" --count "${count}" --output "${children_dir}" >"${workdir}/fork.log"
fork_ms="$(( $(now_ms) - started ))"

phase "fan out"
# Prefix each line with milliseconds since fan-out started. Guest output
# can arrive with CRLF line endings.
started="$(now_ms)"
set +e
"${spore_bin}" checkpoint fanout --for "${timeout}s" "${children_dir}" 2>&1 |
  while IFS= read -r line || [[ -n "${line}" ]]; do
    printf '%6d %s\n' "$(( $(now_ms) - started ))" "${line%$'\r'}"
  done | tee "${workdir}/fanout.log"
fanout_rc="${PIPESTATUS[0]}"
set -e
fanout_ms="$(( $(now_ms) - started ))"

phase "results"
failed=0
examples_run=0
for ((i = 0; i < count; i++)); do
  child="$(printf '%06d' "${i}")"
  response_line="$(grep -E "^ *[0-9]+ \[${child}\] SPOREVM_RAILS_RESPONSE parallel_index=${i} parallel_count=${count} " "${workdir}/fanout.log" | head -n 1 || true)"
  done_line="$(grep -E "^ *[0-9]+ \[${child}\] SPOREVM_RSPEC_DONE parallel_index=${i} parallel_count=${count} examples=[0-9]+ exit=0$" "${workdir}/fanout.log" | head -n 1 || true)"
  if [[ -z "${response_line}" || -z "${done_line}" ]]; then
    printf 'child %s: FAILED\n' "${child}"
    failed=1
    continue
  fi
  read -r response_ms _ <<<"${response_line}"
  read -r done_ms _ <<<"${done_line}"
  child_examples="$(sed -n 's/.* examples=\([0-9]*\) exit=0$/\1/p' <<<"${done_line}")"
  examples_run="$((examples_run + child_examples))"
  printf 'child %s: first_response_ms=%s rspec_done_ms=%s examples=%s\n' "${child}" "${response_ms}" "${done_ms}" "${child_examples}"
done

printf 'timings: build_ms=%s boot_to_ready_ms=%s save_ms=%s fork_ms=%s fanout_ms=%s\n' \
  "${build_ms}" "${ready_ms}" "${save_ms}" "${fork_ms}" "${fanout_ms}"

[[ "${fanout_rc}" == "0" ]] || die "spore checkpoint fanout exited ${fanout_rc}"
[[ "${failed}" == "0" ]] || die "one or more children did not finish their shard"
# A ready line from a child means it loaded Rails itself instead of resuming the fork.
! grep -Fq '] SPOREVM_RAILS_READY' "${workdir}/fanout.log" || die "a child loaded Rails again instead of resuming the warm process"
[[ "${examples_run}" == "${total_examples}" ]] || die "children ran ${examples_run} examples, expected ${total_examples}"
echo "rails fan-out ok: ${count} children ran ${examples_run} examples"
